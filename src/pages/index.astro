---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';

import { units } from '../data/units';

const tickerItems = [
  'Acero al carbono',
  'Acero inoxidable',
  'Aluminio',
  'Bronce',
  'Nylon',
  'POM',
  'Según plano',
  'Según muestra',
  'Series cortas',
];

const indexLinks = [
  ...units.map((unit) => ({ title: unit.shortName, href: unit.href })),
  { title: 'Catálogo', href: '/productos' },
  { title: 'Galería', href: '/galeria' },
  { title: 'Nosotros', href: '/nosotros' },
  { title: 'Presupuesto', href: '/contacto' },
];
---

<BaseLayout
  title="Tornería y mecanizado de precisión"
  description="Tornería y mecanizado de precisión en Argentina. Fabricación de piezas a medida, repuestos industriales y componentes para equipamiento fitness. Solicitá tu presupuesto."
>
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        id="hero-video"
        muted
        loop
        playsinline
        preload="none"
        poster="/images/industrial-chispas.jpg"
      >
        <source src="/video/portada.mp4" type="video/mp4" />
      </video>
      <div class="hero__media-grid"></div>
      <div class="hero__media-overlay"></div>
    </div>

    <div class="container">
      <div class="hero__inner">
        <h1>Repuestos y reparaciones de maquinarias industriales<span class="accent">.</span></h1>

        <div class="hero__actions">
          <Button href="/contacto" variant="ghost" size="sm">Solicitar presupuesto</Button>
          <Button
            href="/docs/carta-presentacion-multimec.pdf"
            variant="ghost"
            size="sm"
            icon="file"
            iconPosition="left"
            external
          >
            Carta de presentación
          </Button>
        </div>
      </div>
    </div>
  </section>

  <script>
    const video = document.getElementById('hero-video') as HTMLVideoElement | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && !reduceMotion) {
      video.preload = 'auto';
      video.autoplay = true;
      video.play().catch(() => {});
    }
  </script>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {
        [0, 1].map((group) => (
          <div class="ticker__group">
            {tickerItems.map((item) => (
              <span class:list={['ticker__item', item === 'Según plano' && 'ticker__item--accent']}>
                {item}
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <nav class="index-list" aria-label="Secciones del sitio">
    <div class="container">
      {
        indexLinks.map((item, i) => (
          <a class="index-row" href={item.href} data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
            <span class="index-row__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="index-row__title">{item.title}</span>
            <span class="index-row__link">
              <span>Saber más</span>
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ))
      }
    </div>
  </nav>
</BaseLayout>
