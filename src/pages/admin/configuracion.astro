---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getMostrarCapital } from '../../lib/config';

const mostrarCapital = await getMostrarCapital(Astro.locals.supabase);
---

<AdminLayout title="Configuración">
  <div class="admin-page-head">
    <div>
      <p class="admin-eyebrow">Panel Multi Mec</p>
      <h1>Configuración</h1>
    </div>
  </div>

  <div class="quote-panel">
    <div class="quote-panel__head">
      <h3>Dashboard</h3>
      <span>Capital</span>
    </div>

    <label class="checkbox">
      <input type="checkbox" id="mostrar-capital" checked={mostrarCapital} />
      Mostrar el capital generado (montos) en el dashboard. Si está apagado, el dashboard
      solo muestra la cantidad de trabajos entregados por período.
    </label>

    <p class="form__status" data-config-status></p>
  </div>

  <div class="quote-panel quote-panel--spaced">
    <div class="quote-panel__head">
      <h3>Notificaciones</h3>
      <span>Vencimientos</span>
    </div>

    <p class="field__hint">
      Una vez por día (alrededor de las 9am) el panel revisa si hay trabajos a 2 días o
      menos de la entrega y te manda una notificación a este dispositivo, aunque tengas
      el navegador cerrado. En iPhone, Apple solo entrega estas notificaciones si instalaste
      el sitio desde "Compartir → Agregar a inicio".
    </p>

    <div class="form__actions">
      <button type="button" class="btn btn--primary" data-push-subscribe>Activar notificaciones</button>
    </div>

    <p class="form__status" data-push-status></p>
  </div>
</AdminLayout>

<script>
  import { requireBrowserSession } from '../../lib/supabase/browser';
  import { setMostrarCapital } from '../../lib/config';

  const checkbox = document.querySelector<HTMLInputElement>('#mostrar-capital');
  const statusEl = document.querySelector<HTMLElement>('[data-config-status]');

  checkbox?.addEventListener('change', async () => {
    checkbox.disabled = true;
    try {
      const supabase = await requireBrowserSession();
      await setMostrarCapital(supabase, checkbox.checked);
      if (statusEl) {
        statusEl.textContent = 'Guardado.';
        statusEl.classList.add('is-visible');
        statusEl.classList.remove('form__status--error');
      }
    } catch (error) {
      console.error('[configuracion]', error);
      checkbox.checked = !checkbox.checked;
      if (statusEl) {
        statusEl.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        statusEl.classList.add('is-visible', 'form__status--error');
      }
    } finally {
      checkbox.disabled = false;
    }
  });

  // Notificaciones push.
  function urlBase64ToUint8Array(base64: string): Uint8Array {
    const padding = '='.repeat((4 - (base64.length % 4)) % 4);
    const normalized = (base64 + padding).replace(/-/g, '+').replace(/_/g, '/');
    const raw = window.atob(normalized);
    return Uint8Array.from([...raw].map((char) => char.charCodeAt(0)));
  }

  const pushBtn = document.querySelector<HTMLButtonElement>('[data-push-subscribe]');
  const pushStatus = document.querySelector<HTMLElement>('[data-push-status]');

  const setPushStatus = (message: string, isError: boolean) => {
    if (!pushStatus) return;
    pushStatus.textContent = message;
    pushStatus.classList.toggle('is-visible', Boolean(message));
    pushStatus.classList.toggle('form__status--error', isError);
  };

  pushBtn?.addEventListener('click', async () => {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      setPushStatus('Este navegador no soporta notificaciones push.', true);
      return;
    }

    pushBtn.disabled = true;
    try {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        throw new Error('No se otorgó el permiso de notificaciones.');
      }

      const registration = await navigator.serviceWorker.register('/sw.js');
      await navigator.serviceWorker.ready;

      const existing = await registration.pushManager.getSubscription();
      const subscription =
        existing ??
        (await registration.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(import.meta.env.PUBLIC_VAPID_KEY),
        }));

      const response = await fetch('/api/admin/push/subscribe', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(subscription.toJSON()),
      });
      if (!response.ok) throw new Error('No se pudo guardar la suscripción en el servidor.');

      pushBtn.textContent = 'Notificaciones activadas ✓';
      setPushStatus('Listo. Vas a recibir un aviso diario si hay entregas cerca de vencer.', false);
    } catch (error) {
      console.error('[push]', error);
      setPushStatus(error instanceof Error ? error.message : 'No se pudo activar las notificaciones.', true);
      pushBtn.disabled = false;
    }
  });
</script>
