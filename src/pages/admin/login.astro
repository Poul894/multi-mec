---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';

// Si ya hay sesión, no tiene sentido mostrar el login de nuevo.
if (Astro.locals.user) {
  return Astro.redirect('/admin');
}

const next = Astro.url.searchParams.get('next') ?? '/admin';
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="Ingresar">
  <div class="admin-login">
    <div class="quote-panel">
      <div class="quote-panel__head">
        <h3>Multi Mec · Panel</h3>
        <span>Acceso administrador</span>
      </div>

      <form class="form" method="POST" action="/api/admin/login">
        <input type="hidden" name="next" value={next} />

        {
          error && (
            <p class="form__status form__status--error is-visible">
              Email o contraseña incorrectos.
            </p>
          )
        }

        <div class="field field--full">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" required />
        </div>

        <div class="field field--full">
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required />
        </div>

        <div class="form__actions">
          <button class="btn btn--primary btn--full" type="submit">Ingresar</button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>
