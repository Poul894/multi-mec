---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import DocumentoForm from '../../../components/admin/DocumentoForm.astro';
---

<AdminLayout title="Remito rápido">
  <div class="admin-page-head">
    <div>
      <p class="admin-eyebrow">Documentos</p>
      <h1>Remito rápido</h1>
    </div>
  </div>

  <p class="form__note doc-intro">
    Cargá a quién se le entrega y el detalle. La fecha se completa sola con el día de hoy. Al finalizar se
    descarga el PDF listo para enviar o imprimir.
  </p>

  <DocumentoForm tipo="remito" />
</AdminLayout>

<style>
  .doc-intro {
    margin-bottom: 20px;
  }
</style>
