---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import JobForm from '../../../components/admin/JobForm.astro';

const prefillFechaEntrega = Astro.url.searchParams.get('fecha');
---

<AdminLayout title="Nuevo trabajo">
  <div class="admin-page-head">
    <div>
      <p class="admin-eyebrow">Control de trabajos</p>
      <h1>Nuevo trabajo</h1>
    </div>
  </div>

  <JobForm prefillFechaEntrega={prefillFechaEntrega} />
</AdminLayout>
