---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import JobForm from '../../../components/admin/JobForm.astro';
import StatusTag from '../../../components/admin/StatusTag.astro';
import { getJob, nextEstado, JOB_STATUS_LABEL } from '../../../lib/jobs';

const { id } = Astro.params;
const job = id ? await getJob(Astro.locals.supabase, id) : null;

if (!job) {
  return new Response(null, { status: 404 });
}

const siguiente = nextEstado(job.estado);
const advanceLabel =
  siguiente === 'entregado' ? 'Marcar entregado' : `Pasar a ${JOB_STATUS_LABEL[siguiente ?? 'pendiente'].toLowerCase()}`;
---

<AdminLayout title={job.titulo}>
  <div class="admin-page-head">
    <div>
      <p class="admin-eyebrow">Control de trabajos</p>
      <h1>{job.titulo}</h1>
    </div>
    <div class="admin-page-head__actions">
      <StatusTag estado={job.estado} />
      {
        siguiente && (
          <button type="button" class="btn btn--outline btn--sm" data-advance data-job-id={job.id} data-next-estado={siguiente}>
            {advanceLabel}
          </button>
        )
      }
      <button type="button" class="btn btn--quiet" data-delete data-job-id={job.id}>
        Eliminar
      </button>
    </div>
  </div>

  <JobForm job={job} />
</AdminLayout>

<script>
  import { createSupabaseBrowserClient } from '../../../lib/supabase/browser';
  import { setJobEstado, deleteJob } from '../../../lib/jobs';
  import type { JobStatus } from '../../../lib/jobs';

  document.querySelector<HTMLButtonElement>('[data-advance]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const jobId = button.dataset.jobId;
    const nextEstado = button.dataset.nextEstado as JobStatus | undefined;
    if (!jobId || !nextEstado) return;
    button.disabled = true;
    try {
      await setJobEstado(createSupabaseBrowserClient(), jobId, nextEstado);
      window.location.reload();
    } catch {
      button.disabled = false;
    }
  });

  document.querySelector<HTMLButtonElement>('[data-delete]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    const jobId = button.dataset.jobId;
    if (!jobId) return;
    if (!window.confirm('¿Eliminar este trabajo? No se puede deshacer.')) return;
    button.disabled = true;
    try {
      await deleteJob(createSupabaseBrowserClient(), jobId);
      window.location.href = '/admin/trabajos';
    } catch {
      button.disabled = false;
    }
  });
</script>
