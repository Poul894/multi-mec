---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFab from '../components/layout/WhatsAppFab.astro';
import GalleryLightbox from '../components/gallery/GalleryLightbox.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.seo.ogImage,
  noindex = false,
  structuredData = [],
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base).toString();
const pageTitle = title ? `${title} · ${site.name}` : site.seo.defaultTitle;
const ogImage = new URL(image, base).toString();
const socialLinks = Object.values(site.social).filter(Boolean);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${base.origin}/#organization`,
  name: site.name,
  legalName: site.legalName,
  url: base.origin,
  logo: new URL('/icon-512.png', base).toString(),
  description: site.description,
  areaServed: {
    '@type': 'Country',
    name: 'Argentina',
  },
  knowsAbout: [
    'Tornería',
    'Mecanizado de precisión',
    'Fabricación de piezas a medida',
    'Repuestos industriales',
    'Componentes para equipamiento fitness',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: site.contact.phoneDisplay,
    email: site.contact.email,
    areaServed: 'AR',
    availableLanguage: ['Spanish'],
  },
  ...(socialLinks.length ? { sameAs: socialLinks } : {}),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${base.origin}/#website`,
  url: base.origin,
  name: site.name,
  inLanguage: 'es-AR',
  publisher: {
    '@id': `${base.origin}/#organization`,
  },
};

const extraSchema = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemas = [organization, website, ...extraSchema].filter(Boolean);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Multi Mec" />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es-ar" href={canonical} />
    <meta name="theme-color" content="#07080a" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Multi Mec — Tornería y mecanizado de precisión" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />

    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <GalleryLightbox />

    <script>
      const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (revealItems.length) {
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );

          revealItems.forEach((item) => observer.observe(item));
        } else {
          revealItems.forEach((item) => item.classList.add('is-visible'));
        }
      }
    </script>
  </body>
</html>
