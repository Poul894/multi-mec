---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import '../styles/global.css';
import '../styles/admin.css';

import AdminHeader from '../components/admin/AdminHeader.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Panel · Multi Mec</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#1d4fc4" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MM Panel" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/admin-manifest.webmanifest" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body id="top" class="admin-shell">
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <AdminHeader />
    <main id="main" tabindex="-1" class="admin-main">
      <slot />
    </main>
  </body>
</html>
