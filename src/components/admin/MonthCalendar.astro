---
import type { MonthCalendar } from '../../lib/calendar';

interface Props {
  calendar: MonthCalendar;
  prevHref: string;
  nextHref: string;
  /** Oculta (atenuadas, sin trabajos ni click) las celdas de días ya pasados. */
  hidePast?: boolean;
}

const { calendar, prevHref, nextHref, hidePast = false } = Astro.props;
const { cells, monthLabel, weekdayLabels } = calendar;

const now = new Date();
const todayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
---

<div class="month-calendar">
  <div class="month-calendar__head">
    <p class="admin-eyebrow admin-eyebrow--month">{monthLabel}</p>
    <div class="month-calendar__nav">
      <a class="btn btn--outline btn--sm" href={prevHref} aria-label="Mes anterior">←</a>
      <a class="btn btn--outline btn--sm" href={nextHref} aria-label="Mes siguiente">→</a>
    </div>
  </div>

  <div class="cal-grid" data-month-calendar>
    {weekdayLabels.map((label) => <div class="cal-weekday">{label}</div>)}
    {
      cells.map((cell) => {
        if (!cell) return <div class="cal-day cal-day--empty" />;

        const isPast = hidePast && cell.dateKey < todayKey;
        if (isPast) {
          return (
            <div class="cal-day cal-day--past">
              <span class="cal-day__num">{cell.day}</span>
            </div>
          );
        }

        const jobsPayload = JSON.stringify(
          cell.jobs.map((job) => ({
            id: job.id,
            titulo: job.titulo,
            cliente_nombre: job.cliente_nombre,
            estado: job.estado,
          })),
        );
        return (
          <div
            class={`cal-day cal-day--${cell.urgenciaCell}`}
            data-cal-day
            data-date-key={cell.dateKey}
            data-jobs={jobsPayload}
            role="button"
            tabindex="0"
          >
            <span class="cal-day__num">{cell.day}</span>
            {cell.jobs.map((job) => (
              <a class="cal-day__job" href={`/admin/trabajos/${job.id}`} title={job.titulo}>
                <span class={`cal-day__job-dot cal-day__job-dot--${job.estado}`} />
                {job.titulo}
              </a>
            ))}
          </div>
        );
      })
    }
  </div>

  {
    hidePast && (
      <p class="month-calendar__hint">
        Los días anteriores a hoy están atenuados. Para ver el historial completo, entrá a{' '}
        <a href="/admin/calendario">Calendario</a>.
      </p>
    )
  }
</div>

<script>
  function formatDateKey(dateKey: string): string {
    const [y, m, d] = dateKey.split('-').map(Number);
    return new Date(y, m - 1, d).toLocaleDateString('es-AR', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    });
  }

  document.querySelectorAll<HTMLElement>('[data-cal-day]').forEach((cell) => {
    const select = () => {
      const jobs = JSON.parse(cell.dataset.jobs ?? '[]');
      const dateKey = cell.dataset.dateKey ?? '';
      document.dispatchEvent(
        new CustomEvent('calendar:day-select', {
          detail: { dateKey, label: formatDateKey(dateKey), jobs },
        }),
      );
    };

    cell.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return; // deja navegar el link del trabajo
      select();
    });

    cell.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        select();
      }
    });
  });
</script>

<style>
  .month-calendar__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .month-calendar__nav {
    display: flex;
    gap: 8px;
  }

  .month-calendar__hint {
    margin-top: 10px;
    font-size: 0.72rem;
    color: var(--muted-2);
  }

  .month-calendar__hint a {
    color: var(--blue-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cal-day {
    cursor: pointer;
  }

  .cal-day--empty {
    cursor: default;
  }

  .cal-day--past {
    cursor: default;
    opacity: 0.3;
  }

  .cal-day:focus-visible {
    outline: 2px solid var(--blue-2);
    outline-offset: -2px;
  }

  .cal-day__job-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex: none;
    margin-right: 5px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.55);
  }

  .cal-day__job-dot--pendiente {
    background: var(--orange);
  }

  .cal-day__job-dot--en_curso {
    background: var(--blue-2);
  }

  .cal-day__job-dot--terminado {
    background: var(--warning);
  }

  .cal-day__job-dot--entregado {
    background: var(--green);
  }
</style>
