---
import { JOB_STATUS_LABEL } from '../../lib/jobs';
import type { Job, JobStatus } from '../../lib/jobs';

interface Props {
  job?: Job;
}

const { job } = Astro.props;
const hoy = new Date().toISOString().slice(0, 10);
const ESTADOS: JobStatus[] = ['pendiente', 'en_curso', 'terminado', 'entregado'];
---

<div class="quote-panel">
  <div class="quote-panel__head">
    <h3>{job ? 'Editar trabajo' : 'Nuevo trabajo'}</h3>
    <span>{job ? job.id.slice(0, 8) : 'Pendiente al crear'}</span>
  </div>

  <form class="form form-grid" data-job-form data-job-id={job?.id ?? ''} data-prev-estado={job?.estado ?? ''}>
    <p class="form__status form__status--error" data-job-form-status></p>

    <div class="field field--full">
      <label for="cliente_nombre">Cliente<span class="req">*</span></label>
      <input id="cliente_nombre" name="cliente_nombre" type="text" required value={job?.cliente_nombre ?? ''} />
    </div>

    <div class="field">
      <label for="cliente_telefono">Teléfono (WhatsApp)</label>
      <input
        id="cliente_telefono"
        name="cliente_telefono"
        type="tel"
        placeholder="5491122334455"
        value={job?.cliente_telefono ?? ''}
      />
    </div>

    <div class="field">
      <label for="estado">Estado</label>
      <select id="estado" name="estado">
        {
          ESTADOS.map((estado) => (
            <option value={estado} selected={(job?.estado ?? 'pendiente') === estado}>
              {JOB_STATUS_LABEL[estado]}
            </option>
          ))
        }
      </select>
    </div>

    <div class="field">
      <label for="fecha_ingreso">Fecha de ingreso</label>
      <input id="fecha_ingreso" name="fecha_ingreso" type="date" value={job?.fecha_ingreso ?? hoy} />
    </div>

    <div class="field">
      <label for="fecha_entrega">Fecha de entrega<span class="req">*</span></label>
      <input id="fecha_entrega" name="fecha_entrega" type="date" required value={job?.fecha_entrega ?? ''} />
    </div>

    <div class="field field--full">
      <label for="titulo">Nombre o descripción de la pieza<span class="req">*</span></label>
      <input id="titulo" name="titulo" type="text" required value={job?.titulo ?? ''} />
    </div>

    <div class="field field--full">
      <label for="descripcion">Detalles del trabajo solicitado</label>
      <textarea id="descripcion" name="descripcion">{job?.descripcion ?? ''}</textarea>
    </div>

    <div class="field">
      <label for="monto">Monto (opcional)</label>
      <input id="monto" name="monto" type="number" min="0" step="0.01" value={job?.monto ?? ''} />
    </div>

    <div class="field field--full">
      <label for="observaciones">Observaciones</label>
      <textarea id="observaciones" name="observaciones">{job?.observaciones ?? ''}</textarea>
    </div>

    <div class="field field--full">
      <label>Fotos del trabajo</label>
      {
        job && job.fotos.length > 0 && (
          <div class="photo-picker" data-existing-photos>
            {job.fotos.map((url) => (
              <div class="photo-picker__item" data-existing-photo={url}>
                <img src={url} alt="" loading="lazy" />
                <label>
                  <input type="checkbox" /> Quitar
                </label>
              </div>
            ))}
          </div>
        )
      }
      <div class="photo-picker" data-new-photos></div>
      <input id="fotos" name="fotos" type="file" accept="image/*" capture="environment" multiple />
      <p class="field__hint">Podés sacar la foto con la cámara o elegirla del dispositivo. Se pueden agregar varias.</p>
    </div>

    <div class="form__actions field--full">
      <button class="btn btn--primary" type="submit">{job ? 'Guardar cambios' : 'Crear trabajo'}</button>
      <a class="btn btn--outline" href="/admin/trabajos">Cancelar</a>
    </div>
  </form>
</div>

<script>
  import { requireBrowserSession } from '../../lib/supabase/browser';
  import { createJob, updateJob } from '../../lib/jobs';
  import type { JobStatus } from '../../lib/jobs';
  import { uploadFoto, fotoPath } from '../../lib/storage';

  const form = document.querySelector<HTMLFormElement>('[data-job-form]');
  if (form) {
    const statusEl = form.querySelector<HTMLElement>('[data-job-form-status]');
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fileInput = form.querySelector<HTMLInputElement>('#fotos');
    const newPhotosContainer = form.querySelector<HTMLElement>('[data-new-photos]');
    let pendingFiles: File[] = [];

    const renderPendingFiles = () => {
      if (!newPhotosContainer) return;
      newPhotosContainer.innerHTML = '';
      pendingFiles.forEach((file, index) => {
        const url = URL.createObjectURL(file);
        const item = document.createElement('div');
        item.className = 'photo-picker__item';

        const img = document.createElement('img');
        img.src = url;
        img.alt = '';

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'photo-picker__remove';
        removeBtn.textContent = 'Quitar';
        removeBtn.addEventListener('click', () => {
          URL.revokeObjectURL(url);
          pendingFiles.splice(index, 1);
          renderPendingFiles();
        });

        item.append(img, removeBtn);
        newPhotosContainer.append(item);
      });
    };

    fileInput?.addEventListener('change', () => {
      pendingFiles.push(...Array.from(fileInput.files ?? []));
      fileInput.value = '';
      renderPendingFiles();
    });

    const setStatus = (message: string, isError: boolean) => {
      if (!statusEl) return;
      statusEl.textContent = message;
      statusEl.classList.toggle('is-visible', Boolean(message));
      statusEl.classList.toggle('form__status--error', isError);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus('', false);
      submitBtn?.setAttribute('disabled', 'true');

      try {
        const supabase = await requireBrowserSession();
        const existingId = form.dataset.jobId;
        const id = existingId || crypto.randomUUID();

        const keptPhotos = Array.from(form.querySelectorAll<HTMLElement>('[data-existing-photo]'))
          .filter((el) => !el.querySelector('input[type="checkbox"]')?.matches(':checked'))
          .map((el) => el.dataset.existingPhoto as string);

        const uploadedUrls: string[] = [];
        for (const file of pendingFiles) {
          const path = fotoPath('trabajos', id, file);
          uploadedUrls.push(await uploadFoto(supabase, path, file));
        }

        const data = new FormData(form);
        const input = {
          titulo: String(data.get('titulo') ?? '').trim(),
          descripcion: String(data.get('descripcion') ?? '').trim(),
          observaciones: String(data.get('observaciones') ?? '').trim(),
          estado: String(data.get('estado') ?? 'pendiente') as JobStatus,
          fecha_ingreso: String(data.get('fecha_ingreso') ?? ''),
          fecha_entrega: String(data.get('fecha_entrega') ?? ''),
          monto: data.get('monto') ? Number(data.get('monto')) : null,
          cliente_nombre: String(data.get('cliente_nombre') ?? '').trim(),
          cliente_telefono: String(data.get('cliente_telefono') ?? '').trim(),
          fotos: [...keptPhotos, ...uploadedUrls],
        };

        if (!input.titulo || !input.cliente_nombre || !input.fecha_entrega) {
          throw new Error('Completá cliente, nombre de la pieza y fecha de entrega.');
        }

        if (existingId) {
          const prevEstado = (form.dataset.prevEstado || null) as JobStatus | null;
          await updateJob(supabase, id, input, prevEstado);
        } else {
          await createJob(supabase, id, input);
        }

        window.location.href = `/admin/trabajos/${id}`;
      } catch (error) {
        console.error('[job-form]', error);
        setStatus(error instanceof Error ? error.message : 'No se pudo guardar el trabajo.', true);
        submitBtn?.removeAttribute('disabled');
      }
    });
  }
</script>
