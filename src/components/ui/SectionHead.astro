---
import Icon from './Icon.astro';

interface Props {
  index?: string;
  eyebrow: string;
  title?: string;
  lead?: string;
  accent?: 'orange' | 'blue';
  center?: boolean;
}

const { index, eyebrow, title, lead, accent = 'orange', center = false } = Astro.props;
---

<div
  class:list={['section-head', center && 'section-head--center']}
  style={`--accent: var(--${accent});`}
  data-reveal
>
  <div class="section-head__title">
    <p class="eyebrow">
      {index && <span class="eyebrow__index">{index} /</span>}
      {eyebrow}
    </p>
    {title && <h2 set:html={title} />}
  </div>
  {lead && <p class="section-head__lead" set:html={lead} />}
</div>

<style>
  .section-head__lead :global(strong) {
    color: var(--white);
    font-weight: 600;
  }

  :global(.section--paper) .section-head__lead :global(strong) {
    color: var(--ink);
  }

  .eyebrow :global(svg) {
    color: var(--accent);
  }
</style>
