---
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-left'
  | 'chevron-down'
  | 'search'
  | 'check'
  | 'plus'
  | 'minus'
  | 'close'
  | 'menu'
  | 'whatsapp'
  | 'mail'
  | 'pin'
  | 'clock'
  | 'truck'
  | 'phone'
  | 'package'
  | 'shield'
  | 'turning'
  | 'milling'
  | 'custom'
  | 'parts'
  | 'series'
  | 'quality';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.5, class: className = '' } = Astro.props;
const filled = name === 'whatsapp';
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></>}
  {name === 'arrow-left' && <><path d="M20 12H5" /><path d="m11 6-6 6 6 6" /></>}
  {name === 'arrow-up-right' && <><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></>}
  {name === 'check' && <path d="m4 12 5 5L20 6" />}
  {name === 'plus' && <><path d="M12 5v14" /><path d="M5 12h14" /></>}
  {name === 'minus' && <path d="M5 12h14" />}
  {name === 'close' && <><path d="M6 6l12 12" /><path d="M18 6 6 18" /></>}
  {name === 'menu' && <><path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h10" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'pin' && <><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'phone' && <path d="M8 3H5a2 2 0 0 0-2 2v3c0 7 6 13 13 13h3a2 2 0 0 0 2-2v-3l-4-2-2 3a14 14 0 0 1-6-6l3-2-2-4Z" />}
  {name === 'truck' && <><path d="M3 6h11v10H3z" /><path d="M14 9h4l3 4v3h-7" /><circle cx="7" cy="18" r="1.8" /><circle cx="17" cy="18" r="1.8" /></>}
  {name === 'package' && <><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4 7.5 8 4.5 8-4.5M12 12v9" /></>}
  {name === 'shield' && <><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z" /><path d="m8.5 12 2.5 2.5 4.5-5" /></>}
  {name === 'turning' && <><path d="M7 6a3 6 0 0 0 0 12M17 6a3 6 0 0 1 0 12M7 6h10M7 18h10" /><path d="M4 12h16" stroke-dasharray="2 3" opacity=".55" /></>}
  {name === 'milling' && <><path d="M10 3h4v7l-2 3-2-3V3Z" /><path d="M6 15h12v6H6z" /><path d="M10 6h4M10 9h4M10 12h4" /></>}
  {name === 'custom' && <><path d="m5 19 9.5-9.5 2 2L7 21H5v-2Z" /><path d="m14 6 4-4 4 4-4 4-4-4Z" /><path d="m3 7 2-2M3 11l2-2M3 15l2-2" /></>}
  {name === 'parts' && <><circle cx="12" cy="12" r="4" /><path d="M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M19 5l-2 2M7 17l-2 2" /></>}
  {name === 'series' && <><path d="m12 3 8 4-8 4-8-4 8-4Z" /><path d="m4 12 8 4 8-4M4 17l8 4 8-4" /></>}
  {name === 'quality' && <><path d="M4 20 20 4" /><path d="M4 14v6h6M10 20h10M14 4h6v6" /><path d="m9 15 2 2M13 15l2 2M17 15l2 2" /></>}
  {name === 'whatsapp' && <path d="M17.5 14.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.1-.2.3-.8 1-1 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6-.1-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.8-.7 2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.7-.5Z" />}
  {name === 'whatsapp' && <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />}
</svg>
