<style>
  .part {
    width: 100%;
    height: 100%;
    color: inherit;
    overflow: visible;
  }

  .outline {
    stroke: currentColor;
    stroke-width: 1.7;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .edge {
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
    opacity: 0.6;
    vector-effect: non-scaling-stroke;
  }

  .thin {
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
    opacity: 0.55;
    vector-effect: non-scaling-stroke;
  }

  .axis {
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
    stroke-dasharray: 14 6 2 6;
    vector-effect: non-scaling-stroke;
  }

  .dashed {
    stroke-dasharray: 10 8;
  }

  .hole {
    stroke: currentColor;
    stroke-width: 1.4;
    fill: var(--ink);
    vector-effect: non-scaling-stroke;
  }

  .accent {
    stroke: var(--part-accent);
    stroke-width: 1.7;
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .center {
