    stroke-width: 1;
  }

  .dim-line,
  .ext,
  .leader {
    stroke: var(--part-accent);
    stroke-width: 1;
    opacity: 0.8;
    vector-effect: non-scaling-stroke;
  }

  .ext {
    opacity: 0.45;
  }

  .leader {
    opacity: 0.55;
  }

  text {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    fill: currentColor;
    opacity: 0.8;
    text-transform: uppercase;
