---
import type { DrawingType } from '../../data/products';

interface Props {
  type: DrawingType;
  accent?: 'orange' | 'blue';
  class?: string;
}

const { type, accent = 'orange', class: className = '' } = Astro.props;

// IDs para patrones y marcadores (render estático).
const uid = `pd-${Math.random().toString(36).slice(2, 8)}`;

const gearTeeth = 16;
const gearStep = (Math.PI * 2) / gearTeeth;
const gearPoints: string[] = [];
for (let i = 0; i < gearTeeth; i++) {
  const a = i * gearStep - Math.PI / 2;
  const points = [
    [a - gearStep * 0.27, 158],
    [a + gearStep * 0.27, 158],
    [a + gearStep * 0.4, 128],
    [a + gearStep * 0.6, 128],
  ];
  points.forEach(([angle, radius], index) => {
    const x = 400 + Math.cos(angle) * radius;
    const y = 300 + Math.sin(angle) * radius;
    gearPoints.push(`${index === 0 && i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`);
  });
}
const gearPath = `${gearPoints.join(' ')} Z`;

const pulleyHoles = [-90, -18, 54, 126, 198].map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return {
    x: (400 + Math.cos(rad) * 94).toFixed(1),
    y: (300 + Math.sin(rad) * 94).toFixed(1),
  };
});

const flangeHoles = [0, 60, 120, 180, 240, 300].map((deg) => {
  const rad = (deg * Math.PI) / 180;
  return {
    x: (400 + Math.cos(rad) * 120).toFixed(1),
    y: (300 + Math.sin(rad) * 120).toFixed(1),
  };
});
---

<svg
  class:list={['part', className]}
  style={`--part-accent: var(--${accent});`}
  viewBox="0 0 800 600"
  role="presentation"
