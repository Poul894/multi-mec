---
import Icon from '../ui/Icon.astro';
---

<dialog class="lightbox" data-lightbox aria-labelledby="lightbox-title">
  <div class="lightbox__media" data-lightbox-media></div>
  <div class="lightbox__caption">
    <div>
      <h3 id="lightbox-title" data-lightbox-title></h3>
      <p data-lightbox-description></p>
    </div>
    <span class="lightbox__code" data-lightbox-code></span>
  </div>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Cerrar imagen">
    <Icon name="close" size={18} />
  </button>
  <div class="lightbox__nav">
    <button type="button" data-lightbox-prev aria-label="Imagen anterior">
      <Icon name="arrow-left" size={16} />
    </button>
    <button type="button" data-lightbox-next aria-label="Imagen siguiente">
      <Icon name="arrow-right" size={16} />
    </button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');

  if (dialog) {
    const allTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]'));
    const media = dialog.querySelector<HTMLElement>('[data-lightbox-media]');
    const title = dialog.querySelector<HTMLElement>('[data-lightbox-title]');
    const description = dialog.querySelector<HTMLElement>('[data-lightbox-description]');
    const code = dialog.querySelector<HTMLElement>('[data-lightbox-code]');
    let current = 0;

    const visibleTriggers = () =>
      allTriggers.filter((trigger) => !trigger.closest<HTMLElement>('.gallery-item')?.hidden);

    const show = (index: number) => {
      const triggers = visibleTriggers();
      if (!triggers.length || !media) return;
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      const item = trigger.closest('.gallery-item');
      const source = item?.querySelector('.gallery-item__media');

      media.innerHTML = source ? source.innerHTML : '';
      if (title) title.textContent = trigger.dataset.title ?? '';
      if (description) description.textContent = trigger.dataset.description ?? '';
      if (code) code.textContent = trigger.dataset.code ?? '';
    };

    allTriggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const triggers = visibleTriggers();
        show(triggers.indexOf(trigger));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
